<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Line?>

<VBox prefHeight="800.0" prefWidth="1280.0" spacing="0.0" styleClass="app-shell" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ma.ensate.client.views.ProduitDetailsView">
    <children>
        <!-- Header -->
        <HBox alignment="CENTER_LEFT" prefHeight="90.0" styleClass="header-section">
            <children>
                <Button onAction="#retourner" styleClass="logout-btn" text="← VERS LE CATALOGUE" />
                <Region HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER" spacing="10.0" styleClass="brand-outline">
                    <children>
                        <Label styleClass="brand-mark" text="ChriOnline" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets left="42.0" right="42.0" />
            </padding>
        </HBox>

        <ScrollPane fitToWidth="true" styleClass="content-scroll" VBox.vgrow="ALWAYS">
            <content>
                <HBox alignment="TOP_CENTER" spacing="80.0">
                    <children>
                        <!-- Media Display (Left) -->
                        <VBox alignment="TOP_CENTER" prefWidth="550.0" spacing="25.0">
                            <children>
                                <StackPane styleClass="feature-image-box">
                                    <children>
                                        <Label style="-fx-font-size: 140px; -fx-opacity: 0.05;" text="DEVICES" styleClass="catalog-sidebar-label" />
                                        <ImageView fx:id="produitImageView" fitHeight="480.0" fitWidth="480.0" pickOnBounds="true" preserveRatio="true" />
                                    </children>
                                </StackPane>
                                
                                <VBox spacing="15.0" styleClass="summary-card">
                                    <children>
                                        <Label styleClass="catalog-sidebar-label" text="SÉCURITÉ &amp; AUTHENTICITÉ" />
                                        <Label styleClass="hero-subtitle" text="Produit vérifié et certifié conforme par le réseau ChriOnline." />
                                    </children>
                                    <padding>
                                        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
                                    </padding>
                                </VBox>
                            </children>
                        </VBox>

                        <!-- Product info (Right) -->
                        <VBox prefWidth="500.0" spacing="40.0">
                            <children>
                                <VBox spacing="12">
                                    <children>
                                        <Label fx:id="categorieLabel" styleClass="section-kicker" text="SÉRIE PREMIUM" />
                                        <Label fx:id="nomLabel" styleClass="section-title" text="Désignation" wrapText="true" />
                                        <Line endX="100.0" styleClass="section-divider" />
                                    </children>
                                </VBox>

                                <VBox spacing="25.0" styleClass="feature-card">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                                            <children>
                                                <Label fx:id="prixLabel" styleClass="summary-total-accent" text="0.00 MAD" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label fx:id="stockLabel" styleClass="stock-pill" text="DISPONIBLE" />
                                            </children>
                                        </HBox>

                                        <VBox spacing="10">
                                            <children>
                                                <Label styleClass="catalog-sidebar-label" text="DESCRIPTION DE L'ARTICLE" />
                                                <Label fx:id="descriptionLabel" styleClass="feature-copy" text="..." wrapText="true" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="15.0">
                                            <children>
                                                <Button maxWidth="Infinity" onAction="#handleAddToCart" prefHeight="65.0" styleClass="secondary-btn" text="AJOUTER AU PANIER" />
                                                <Button maxWidth="Infinity" onAction="#handleBuyNow" prefHeight="60.0" styleClass="outline-btn" text="ACHAT IMMÉDIAT" />
                                            </children>
                                            <padding>
                                                <Insets top="20.0" />
                                            </padding>
                                        </VBox>
                                    </children>
                                </VBox>
                                
                                <VBox spacing="15.0" styleClass="shipping-card">
                                    <children>
                                        <Label styleClass="catalog-sidebar-accent" text="LIVRAISON ESTIMÉE" />
                                        <Label styleClass="hero-subtitle" text="Sous 48h à 72h partout au Maroc." />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                    <padding>
                        <Insets bottom="80.0" left="42.0" right="42.0" top="60.0" />
                    </padding>
                </HBox>
            </content>
        </ScrollPane>
    </children>
</VBox>
