<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="800.0" prefWidth="1280.0" spacing="0.0" styleClass="app-shell" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ma.ensate.client.views.AdminProduitsView">
    <children>
        <!-- Global Header -->
        <HBox alignment="CENTER_LEFT" prefHeight="90.0" styleClass="header-section">
            <children>
                <HBox alignment="CENTER" spacing="10.0" styleClass="brand-outline">
                    <children>
                        <Label styleClass="brand-mark" text="ChriOnline" />
                    </children>
                </HBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER" spacing="25.0">
                    <children>
                        <Button mnemonicParsing="false" styleClass="nav-link-btn, nav-link-btn-active" text="PRODUITS" />
                        <Button mnemonicParsing="false" onAction="#handleCommandesPlaceholder" styleClass="nav-link-btn" text="COMMANDES" />
                        <Button mnemonicParsing="false" onAction="#handleUtilisateurs" styleClass="nav-link-btn" text="UTILISATEURS" />
                        
                        <Region prefWidth="15.0" />
                        <VBox alignment="CENTER_RIGHT" spacing="2.0">
                            <children>
                                <Label text="ADMINISTRATEUR" style="-fx-text-fill: #ff9fc7; -fx-font-size: 11px; -fx-font-weight: 900; -fx-letter-spacing: 1.2px;" />
                                <Label text="PANEL DE GESTION" style="-fx-text-fill: #6b7898; -fx-font-size: 10px; -fx-font-weight: 700;" />
                            </children>
                        </VBox>

                        <Button mnemonicParsing="false" onAction="#handleLogout" styleClass="logout-btn" text="DÉCONNEXION">
                           <HBox.margin>
                              <Insets left="10.0" />
                           </HBox.margin>
                        </Button>
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets left="42.0" right="42.0" />
            </padding>
        </HBox>

        <!-- Main Content Area -->
        <ScrollPane fitToWidth="true" styleClass="content-scroll" VBox.vgrow="ALWAYS">
            <content>
                <VBox spacing="35.0" styleClass="catalog-wrap">
                    <children>
                        <!-- Title and Quick Actions -->
                        <HBox alignment="TOP_LEFT" spacing="20">
                            <children>
                                <VBox spacing="10" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="section-kicker" text="INVENTORY MANAGEMENT" />
                                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                                            <children>
                                                <Label styleClass="section-title" text="GESTION DES" />
                                                <Label styleClass="section-title-accent" text="PRODUITS" />
                                            </children>
                                        </HBox>
                                        <Line endX="100.0" styleClass="section-divider" />
                                        <Label styleClass="hero-subtitle" text="Ajoutez, modifiez ou supprimez des articles de votre catalogue en temps réel." />
                                    </children>
                                </VBox>
                                <HBox alignment="BOTTOM_RIGHT" spacing="15">
                                    <children>
                                        <ComboBox fx:id="categoryComboBox" onAction="#handleCategoryFilter" prefHeight="45.0" prefWidth="220.0" promptText="FILTRER PAR CATÉGORIE" styleClass="combo-box" />
                                        <Button onAction="#refreshProducts" styleClass="outline-btn" text="ACTUALISER" />
                                        <Button onAction="#handleAjouterProduit" styleClass="secondary-btn" text="+ NOUVEAU PRODUIT" />
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <!-- Products Table Box -->
                        <VBox spacing="25.0" styleClass="feature-card">
                            <children>
                                <TableView fx:id="productsTable" minHeight="500.0" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="idColumn" prefWidth="100.0" text="REF#" />
                                        <TableColumn fx:id="nomColumn" prefWidth="300.0" text="DÉSIGNATION PRODUIT" />
                                        <TableColumn fx:id="categoryColumn" prefWidth="200.0" text="CATÉGORIE" />
                                        <TableColumn fx:id="prixColumn" prefWidth="150.0" text="PRIX (MAD)" />
                                        <TableColumn fx:id="stockColumn" prefWidth="120.0" text="STOCK" />
                                        <TableColumn fx:id="actionsColumn" prefWidth="200.0" text="ACTIONS" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                                
                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <children>
                                        <Label fx:id="statusLabel" styleClass="catalog-sidebar-label" text="Prêt." />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button onAction="#handleSupprimer" styleClass="outline-btn" text="SUPPRIMER SÉLÉCTION" style="-fx-text-fill: #ffb86b; -fx-border-color: rgba(255, 184, 107, 0.4);" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>