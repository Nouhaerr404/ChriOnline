<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="620.0" prefWidth="980.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ma.ensate.client.views.AdminCommandeView">
   <children>
      <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <top>
            <!-- HEADER SECTION IDENTIQUE AUX AUTRES PAGES ADMIN -->
            <VBox spacing="14.0" styleClass="header-section" BorderPane.alignment="CENTER">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="14.0">
                     <children>
                        <Label text="Dashboard Administrateur - Commandes" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="24.0" />
                           </font>
                        </Label>
                        <AnchorPane HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleUtilisateurs" styleClass="secondary-btn" text="Gérer Utilisateurs" />
                        <Button onAction="#handleBack" styleClass="secondary-btn" text="Produits" />
                        <Button onAction="#handleHistoriquePlaceholder" styleClass="secondary-btn" text="Historique" />
                        <Button onAction="#handleLogout" styleClass="secondary-btn" text="Deconnexion" />
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="16.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </VBox>
         </top>
         <center>
            <VBox spacing="20.0" BorderPane.alignment="CENTER">
               <children>
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Gestion des Commandes" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                        <Label text="Visualisez et gérez le cycle de vie des commandes clients" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" />
                     </children>
                  </VBox>

                  <TableView fx:id="commandesTable" VBox.vgrow="ALWAYS" styleClass="admin-table">
                    <columns>
                      <TableColumn fx:id="idColumn" prefWidth="120.0" text="N° Commande" />
                      <TableColumn fx:id="clientColumn" prefWidth="150.0" text="Client" />
                        <TableColumn fx:id="dateColumn" prefWidth="160.0" text="Date de commande" />
                        <TableColumn fx:id="prixColumn" prefWidth="120.0" text="Montant (MAD)" />
                        <TableColumn fx:id="detailsColumn" prefWidth="250.0" text="Détails Articles" />
                        <TableColumn fx:id="statutColumn" prefWidth="140.0" text="Statut" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
                  
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label fx:id="statusLabel" text="Prêt" textFill="#7f8c8d" />
                        <AnchorPane HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#handleRefresh" styleClass="primary-btn" text="Actualiser la liste" />
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </VBox>
         </center>
      </BorderPane>
   </children>
</AnchorPane>
