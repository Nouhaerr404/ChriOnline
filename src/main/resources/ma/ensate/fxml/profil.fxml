<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ma.ensate.client.views.ProfilView"
            style="-fx-background-color: #f0f4f8;">
    <content>
        <VBox spacing="15"
              style="-fx-background-color: #f0f4f8; -fx-padding: 30;">

            <!-- TITRE -->
            <Label text="Mon Profil"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;
                          -fx-text-fill: #1F4E79;"/>

            <!-- CARTE INFOS -->
            <VBox spacing="12"
                  style="-fx-background-color: white;
                         -fx-padding: 20;
                         -fx-background-radius: 10;
                         -fx-effect: dropshadow(gaussian,#ccc,10,0,0,2);">

                <Label text="Informations personnelles"
                       style="-fx-font-weight: bold; -fx-text-fill: #2E75B6;
                              -fx-font-size: 14px;"/>

                <Label text="Nom complet"
                       style="-fx-font-weight: bold; -fx-text-fill: #333;"/>
                <TextField fx:id="nomField"
                           style="-fx-padding: 8; -fx-background-radius: 5;
                                  -fx-border-color: #ddd; -fx-border-radius: 5;"/>

                <Label text="Email (non modifiable)"
                       style="-fx-font-weight: bold; -fx-text-fill: #333;"/>
                <TextField fx:id="emailField" editable="false"
                           style="-fx-padding: 8; -fx-background-radius: 5;
                                  -fx-background-color: #f5f5f5;
                                  -fx-border-color: #ddd; -fx-border-radius: 5;"/>

                <Label text="Adresse"
                       style="-fx-font-weight: bold; -fx-text-fill: #333;"/>
                <TextField fx:id="adresseField"
                           style="-fx-padding: 8; -fx-background-radius: 5;
                                  -fx-border-color: #ddd; -fx-border-radius: 5;"/>

                <Label text="Téléphone"
                       style="-fx-font-weight: bold; -fx-text-fill: #333;"/>
                <TextField fx:id="telField"
                           style="-fx-padding: 8; -fx-background-radius: 5;
                                  -fx-border-color: #ddd; -fx-border-radius: 5;"/>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Statut :"
                           style="-fx-font-weight: bold; -fx-text-fill: #333;"/>
                    <Label fx:id="statutLabel"
                           style="-fx-font-weight: bold;"/>
                </HBox>

                <Label fx:id="messageLabel" text=""
                       wrapText="true"
                       style="-fx-font-size: 12px;"/>

                <Button text="Sauvegarder les modifications"
                        onAction="#handleUpdateProfil"
                        maxWidth="Infinity"
                        style="-fx-background-color: #2E75B6;
                               -fx-text-fill: white; -fx-padding: 10;
                               -fx-background-radius: 5; -fx-cursor: hand;"/>
            </VBox>

            <!-- CARTE MOT DE PASSE -->
            <VBox spacing="12"
                  style="-fx-background-color: white;
                         -fx-padding: 20;
                         -fx-background-radius: 10;
                         -fx-effect: dropshadow(gaussian,#ccc,10,0,0,2);">

                <Label text="Changer le mot de passe"
                       style="-fx-font-weight: bold; -fx-text-fill: #2E75B6;
                              -fx-font-size: 14px;"/>

                <!-- ANCIEN MOT DE PASSE avec oeil -->
                <Label text="Ancien mot de passe"
                       style="-fx-font-weight: bold; -fx-text-fill: #333;"/>
                <HBox spacing="5" alignment="CENTER_LEFT">
                    <PasswordField fx:id="ancienPasswordField"
                                   HBox.hgrow="ALWAYS"
                                   style="-fx-padding: 8; -fx-background-radius: 5;
                                          -fx-border-color: #ddd; -fx-border-radius: 5;"/>
                    <TextField fx:id="ancienPasswordVisible"
                               HBox.hgrow="ALWAYS"
                               visible="false" managed="false"
                               style="-fx-padding: 8; -fx-background-radius: 5;
                                      -fx-border-color: #ddd; -fx-border-radius: 5;"/>
                    <Button fx:id="toggleAncienBtn"
                            text="👁"
                            onAction="#toggleAncienPassword"
                            style="-fx-background-color: transparent;
                                   -fx-font-size: 16px; -fx-cursor: hand;
                                   -fx-border-color: #ddd; -fx-border-radius: 5;
                                   -fx-padding: 5;"/>
                </HBox>

                <!-- NOUVEAU MOT DE PASSE avec oeil -->
                <Label text="Nouveau mot de passe"
                       style="-fx-font-weight: bold; -fx-text-fill: #333;"/>
                <HBox spacing="5" alignment="CENTER_LEFT">
                    <PasswordField fx:id="nouveauPasswordField"
                                   HBox.hgrow="ALWAYS"
                                   style="-fx-padding: 8; -fx-background-radius: 5;
                                          -fx-border-color: #ddd; -fx-border-radius: 5;"/>
                    <TextField fx:id="nouveauPasswordVisible"
                               HBox.hgrow="ALWAYS"
                               visible="false" managed="false"
                               style="-fx-padding: 8; -fx-background-radius: 5;
                                      -fx-border-color: #ddd; -fx-border-radius: 5;"/>
                    <Button fx:id="toggleNouveauBtn"
                            text="👁"
                            onAction="#toggleNouveauPassword"
                            style="-fx-background-color: transparent;
                                   -fx-font-size: 16px; -fx-cursor: hand;
                                   -fx-border-color: #ddd; -fx-border-radius: 5;
                                   -fx-padding: 5;"/>
                </HBox>

                <Label fx:id="passwordMessageLabel" text=""
                       wrapText="true"
                       style="-fx-font-size: 12px;"/>

                <Button text="Changer le mot de passe"
                        onAction="#handleChangerPassword"
                        maxWidth="Infinity"
                        style="-fx-background-color: #C00000;
                               -fx-text-fill: white; -fx-padding: 10;
                               -fx-background-radius: 5; -fx-cursor: hand;"/>
            </VBox>

            <!-- BOUTON RETOUR -->
            <Button text="← Retour"
                    onAction="#handleRetour"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #2E75B6;
                           -fx-cursor: hand; -fx-font-size: 13px;"/>
        </VBox>
    </content>
</ScrollPane>