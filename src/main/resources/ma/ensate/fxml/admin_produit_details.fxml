<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Line?>

<VBox prefHeight="700.0" prefWidth="950.0" spacing="0.0" styleClass="app-shell" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ma.ensate.client.views.AdminProduitDetailsView">
    <children>
        <!-- Compact Header -->
        <HBox alignment="CENTER_LEFT" prefHeight="80.0" styleClass="header-section">
            <children>
                <Button onAction="#retourner" styleClass="logout-btn" text="← RETOUR INVENTAIRE" />
                <Region HBox.hgrow="ALWAYS" />
                <Label text="INSPECTION PRODUIT" style="-fx-text-fill: #ff9fc7; -fx-font-weight: 900; -fx-font-size: 14px; -fx-letter-spacing: 2;" />
            </children>
            <padding>
                <Insets left="30.0" right="30.0" />
            </padding>
        </HBox>

        <HBox spacing="40.0" VBox.vgrow="ALWAYS">
            <children>
                <!-- Image Side -->
                <VBox prefWidth="380.0" spacing="20.0">
                    <children>
                        <StackPane styleClass="feature-image-box" VBox.vgrow="ALWAYS">
                            <children>
                                <Label text="IMAGE PREVIEW" styleClass="catalog-sidebar-label" />
                                <ImageView fx:id="produitImageView" fitHeight="340.0" fitWidth="340.0" pickOnBounds="true" preserveRatio="true" />
                            </children>
                        </StackPane>
                        <VBox spacing="10.0" styleClass="summary-card">
                            <children>
                                <Label styleClass="catalog-sidebar-label" text="RÉSUMÉ ANALYTIQUE" />
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label text="REF ID:" styleClass="catalog-sidebar-label" />
                                    <Label fx:id="idLabel" styleClass="catalog-price-small" text="#000" />
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <!-- Data Side -->
                <VBox spacing="30.0" HBox.hgrow="ALWAYS">
                    <children>
                        <VBox spacing="10">
                            <children>
                                <Label fx:id="categorieLabel" styleClass="section-kicker" text="SÉRIE X500" />
                                <Label fx:id="nomLabel" styleClass="section-title" text="Désignation" wrapText="true" />
                                <Line endX="80.0" styleClass="section-divider" />
                            </children>
                        </VBox>

                        <VBox spacing="25.0" styleClass="feature-card">
                            <children>
                                <Label fx:id="prixLabel" styleClass="summary-total-accent" text="0.00 MAD" />
                                
                                <VBox spacing="10">
                                    <Label styleClass="catalog-sidebar-label" text="DESCRIPTION TECHNIQUE" />
                                    <Label fx:id="descriptionLabel" styleClass="feature-copy" text="Chargement..." wrapText="true" />
                                </VBox>

                                <HBox spacing="30">
                                    <VBox spacing="5">
                                        <Label styleClass="catalog-sidebar-label" text="STOCK ACTUEL" />
                                        <Label fx:id="stockLabel" styleClass="product-stock" text="0 UNITES" style="-fx-text-fill: #5cff90; -fx-font-size: 20px;" />
                                    </VBox>
                                    <VBox spacing="5">
                                        <Label styleClass="catalog-sidebar-label" text="ÉTAT" />
                                        <Label styleClass="stock-pill" text="DISPONIBLE" />
                                    </VBox>
                                </HBox>

                                <HBox spacing="15.0" alignment="BOTTOM_RIGHT">
                                    <children>
                                        <Button onAction="#supprimerProduit" styleClass="outline-btn" text="SUPPRIMER" style="-fx-text-fill: #ffb86b; -fx-border-color: #ffb86b;" />
                                        <Button onAction="#modifierProduit" styleClass="secondary-btn" text="MODIFIER LES INFOS" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="30.0" />
            </padding>
        </HBox>
    </children>
</VBox>
