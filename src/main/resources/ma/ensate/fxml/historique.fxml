<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Line?>

<StackPane fx:id="rootPane" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <VBox prefHeight="800.0" prefWidth="1280.0" spacing="0" styleClass="app-shell">
         <children>
            <!-- Global Header -->
            <HBox alignment="CENTER_LEFT" prefHeight="90.0" styleClass="header-section">
               <children>
                  <HBox alignment="CENTER" spacing="10.0" styleClass="brand-outline">
                      <children>
                          <Label styleClass="brand-mark" text="ChriOnline" />
                      </children>
                  </HBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <HBox alignment="CENTER" spacing="25.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#retourBoutique" styleClass="nav-link-btn" text="BOUTIQUE" />
                        <Button mnemonicParsing="false" styleClass="nav-link-btn, nav-link-active" text="COMMANDES" />
                        <Button mnemonicParsing="false" onAction="#goToPanier" styleClass="nav-link-btn" text="PANIER" />
                         <Button mnemonicParsing="false" onAction="#goToProfil" styleClass="profile-bubble-btn">
                             <graphic>
                                 <HBox alignment="CENTER" mouseTransparent="true" pickOnBounds="true" spacing="12.0" styleClass="profile-bubble">
                                     <children>
                                         <Label fx:id="profileHoverLabel" mouseTransparent="true" styleClass="profile-hover" text="MON COMPTE" visible="false" managed="false"/>
                                         <Label fx:id="profileInitialLabel" mouseTransparent="true" styleClass="profile-initial" text="U" />
                                     </children>
                                 </HBox>
                             </graphic>
                         </Button>
                        <Button mnemonicParsing="false" onAction="#handleDeconnexion" styleClass="logout-btn" text="DÉCONNEXION">
                           <HBox.margin>
                              <Insets left="15.0" />
                           </HBox.margin>
                        </Button>
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets left="42.0" right="42.0" />
               </padding>
            </HBox>

            <HBox VBox.vgrow="ALWAYS" styleClass="catalog-wrap">
               <children>
                  <!-- Sidebar Navigation -->
                  <VBox minWidth="280.0" prefWidth="280.0" spacing="40.0" styleClass="catalog-sidebar">
                     <children>
                        <VBox spacing="10.0">
                            <children>
                                <Label text="MON COMPTE" styleClass="catalog-sidebar-label" />
                                <Label text="GESTION CLIENT" styleClass="catalog-sidebar-accent" />
                            </children>
                        </VBox>
                        <VBox spacing="12.0">
                           <children>
                              <Button alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#modifierProfil" styleClass="catalog-side-link" text="Infos Personnelles" />
                              <Button alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" styleClass="catalog-side-link, catalog-side-link-active" text="Historique Commandes" />
                           </children>
                        </VBox>
                        
                        <Region VBox.vgrow="ALWAYS" />
                        
                        <VBox styleClass="shipping-card" spacing="10.0">
                            <children>
                                <Label text="BESOIN D'AIDE ?" styleClass="shipping-title" />
                                <Label text="Contactez notre support 24/7 pour toute question sur vos commandes." styleClass="shipping-copy" wrapText="true" />
                            </children>
                        </VBox>
                     </children>
                  </VBox>

                  <!-- Main Content -->
                  <ScrollPane fitToWidth="true" styleClass="content-scroll" HBox.hgrow="ALWAYS">
                     <content>
                        <VBox spacing="45.0" style="-fx-padding: 0 0 0 45;">
                           <children>
                              <VBox spacing="12.0">
                                  <children>
                                      <Label text="VOS ACHATS" styleClass="section-kicker" />
                                      <HBox alignment="CENTER_LEFT" spacing="20.0">
                                          <children>
                                              <Label text="HISTORIQUE" styleClass="section-title" />
                                              <Label text="COMMANDES" styleClass="section-title-accent" />
                                          </children>
                                      </HBox>
                                      <Line endX="100.0" styleClass="section-divider" />
                                      <Label styleClass="hero-subtitle" text="Retrouvez ici le détail de toutes vos commandes passées sur ChriOnline." />
                                  </children>
                              </VBox>

                              <VBox fx:id="container" spacing="20.0">
                                 <!-- Dynamic Order Cards -->
                              </VBox>
                           </children>
                        </VBox>
                     </content>
                  </ScrollPane>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</StackPane>
