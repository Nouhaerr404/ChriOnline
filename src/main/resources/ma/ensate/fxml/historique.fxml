<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <BorderPane style="-fx-background-color: #F1F5F9;">
        <top>
            <VBox spacing="10" style="-fx-background-color: #0F172A;">
                <padding><Insets top="30" right="50" bottom="30" left="50"/></padding>
                <Button text="← BOUTIQUE" style="-fx-background-color: transparent; -fx-text-fill: #3B82F6; -fx-font-weight: bold; -fx-cursor: hand;" onAction="#retourBoutique"/>
                <Label text="Tableau de bord des commandes" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </VBox>
        </top>
        <center>
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;">
                <VBox fx:id="container" spacing="20" alignment="TOP_CENTER">
                    <padding><Insets top="40" right="50" bottom="40" left="50"/></padding>
                </VBox>
            </ScrollPane>
        </center>
    </BorderPane>
</StackPane>
