<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Line?>

<VBox alignment="CENTER" spacing="0" styleClass="app-shell" stylesheets="@../css/style.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17" fx:controller="ma.ensate.client.views.AdminLoginView">
    <children>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;" styleClass="content-scroll">
            <content>
                <VBox alignment="CENTER" spacing="20.0" style="-fx-padding: 40 0;">
                    <children>
                        <VBox alignment="CENTER" spacing="25" maxWidth="500" styleClass="summary-card" style="-fx-padding: 40;">
                            <children>
                                <VBox alignment="CENTER" spacing="10">
                                    <children>
                                        <HBox alignment="CENTER" spacing="10.0" styleClass="brand-outline">
                                            <children>
                                                <Label styleClass="brand-mark" text="ChriOnline Admin" />
                                            </children>
                                        </HBox>
                                        <Label styleClass="section-kicker" text="AUTHENTIFICATION RSA" />
                                        <Line endX="60" styleClass="section-divider" />
                                    </children>
                                </VBox>

                                <VBox spacing="20" fillWidth="true">
                                    <children>
                                        <!-- Email Field -->
                                        <VBox spacing="8">
                                            <children>
                                                <Label text="EMAIL ADMINISTRATEUR" styleClass="catalog-sidebar-label" />
                                                <TextField fx:id="emailField" promptText="admin@chrionline.ma" prefHeight="50" styleClass="promo-field" />
                                            </children>
                                        </VBox>

                                        <!-- Private Key Field -->
                                        <VBox spacing="8">
                                            <children>
                                                <Label text="CLÉ PRIVÉE (.pem)" styleClass="catalog-sidebar-label" />
                                                <HBox alignment="CENTER_LEFT" spacing="10">
                                                    <children>
                                                        <TextField fx:id="privateKeyPathField" editable="false" promptText="Sélectionnez votre fichier .pem" prefHeight="50" styleClass="promo-field" HBox.hgrow="ALWAYS" />
                                                        <Button fx:id="browseButton" onAction="#handleBrowsePrivateKey" prefHeight="50" prefWidth="120" styleClass="outline-btn" text="PARCOURIR" style="-fx-padding: 0 10; -fx-font-size: 11px;" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                        
                                        <!-- Information section -->
                                        <VBox spacing="8" styleClass="shipping-card" style="-fx-padding: 15;">
                                            <children>
                                                <Label text="Challenge-Response" styleClass="shipping-title" style="-fx-font-size: 14px;" />
                                                <Label text="Le serveur génère un challenge aléatoire que vous signez localement avec votre clé privée. Votre clé n'est jamais transmise." wrapText="true" styleClass="shipping-copy" style="-fx-font-size: 12px;"/>
                                            </children>
                                        </VBox>

                                        <ProgressBar fx:id="progressBar" visible="false" maxWidth="Infinity" style="-fx-accent: #ff5da9;"/>

                                        <Label fx:id="messageLabel" styleClass="catalog-sidebar-accent" text="" wrapText="true" alignment="CENTER" maxWidth="Infinity" />

                                        <Button fx:id="loginButton"
                                                text="S'AUTHENTIFIER"
                                                onAction="#handleAdminLogin"
                                                maxWidth="Infinity"
                                                prefHeight="50"
                                                styleClass="secondary-btn"/>


                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>
