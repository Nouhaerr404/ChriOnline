<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Line?>

<VBox alignment="CENTER" spacing="0" styleClass="app-shell" stylesheets="@../css/style.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17" fx:controller="ma.ensate.client.views.LoginView">
    <children>
        <VBox alignment="CENTER" spacing="35" maxWidth="500" styleClass="summary-card" style="-fx-padding: 50;">
            <children>
                <VBox alignment="CENTER" spacing="15">
                    <children>
                        <HBox alignment="CENTER" spacing="10.0" styleClass="brand-outline">
                            <children>
                                <Label styleClass="brand-mark" text="ChriOnline" />
                            </children>
                        </HBox>
                        <Label styleClass="section-kicker" text="ACCÈS SÉCURISÉ" />
                        <Line endX="60" styleClass="section-divider" />
                    </children>
                </VBox>

                <VBox spacing="25" fillWidth="true">
                    <children>
                        <!-- Email Field -->
                        <VBox spacing="10">
                            <children>
                                <Label text="EMAIL PROFESSIONNEL" styleClass="catalog-sidebar-label" />
                                <TextField fx:id="emailField" promptText="nom@exemple.com" prefHeight="55" styleClass="promo-field" />
                            </children>
                        </VBox>

                        <!-- Password Field -->
                        <VBox spacing="10">
                            <children>
                                <Label text="MOT DE PASSE" styleClass="catalog-sidebar-label" />
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <children>
                                        <StackPane HBox.hgrow="ALWAYS">
                                            <children>
                                                <PasswordField fx:id="passwordField" prefHeight="55" promptText="••••••••" styleClass="promo-field" />
                                                <TextField fx:id="passwordVisibleField" managed="false" prefHeight="55" promptText="Votre mot de passe" visible="false" styleClass="promo-field" />
                                            </children>
                                        </StackPane>
                                        <Button fx:id="togglePasswordBtn" onAction="#togglePassword" prefHeight="55" prefWidth="80" styleClass="outline-btn" text="VOIR" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Captcha Section -->
                        <VBox spacing="15" styleClass="shipping-card">
                            <children>
                                <Label text="SÉCURITÉ ANTI-BOT" styleClass="shipping-title" />
                                <HBox alignment="CENTER" spacing="15">
                                    <children>
                                        <ImageView fx:id="captchaImageView" fitHeight="60" fitWidth="180" pickOnBounds="true" preserveRatio="true" />
                                        <Button fx:id="refreshCaptchaBtn" onAction="#handleRefreshCaptcha" prefHeight="50" styleClass="outline-btn" text="↻" />
                                    </children>
                                </HBox>
                                <TextField fx:id="captchaField" prefHeight="50" promptText="Saisissez le code" styleClass="promo-field" />
                            </children>
                        </VBox>

                        <Label fx:id="messageLabel" styleClass="catalog-sidebar-accent" text="" wrapText="true" />

        <Button fx:id="adminLoginButton"
                text="🔐 Connexion Admin (RSA)"
                onAction="#allerAdminLogin"
                maxWidth="Infinity"
                style="-fx-background-color: #667eea;
                       -fx-text-fill: white;
                       -fx-font-size: 12px;
                       -fx-padding: 10;
                       -fx-background-radius: 5;
                       -fx-cursor: hand;"/>

    </VBox>
</VBox>
