<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Line?>

<VBox alignment="CENTER" spacing="0" styleClass="app-shell" stylesheets="@../css/style.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17" fx:controller="ma.ensate.client.views.LoginView">
    <children>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;" styleClass="content-scroll">
            <content>
                <VBox alignment="CENTER" spacing="20.0" style="-fx-padding: 40 0;">
                    <children>
                        <VBox alignment="CENTER" spacing="25" maxWidth="500" styleClass="summary-card" style="-fx-padding: 40;">
                            <children>
                                <VBox alignment="CENTER" spacing="10">
                                    <children>
                                        <HBox alignment="CENTER" spacing="10.0" styleClass="brand-outline">
                                            <children>
                                                <Label styleClass="brand-mark" text="ChriOnline" />
                                            </children>
                                        </HBox>
                                        <Label styleClass="section-kicker" text="ACCÈS SÉCURISÉ" />
                                        <Line endX="60" styleClass="section-divider" />
                                    </children>
                                </VBox>

                                <VBox spacing="20" fillWidth="true">
                                    <children>
                                        <!-- Email Field -->
                                        <VBox spacing="8">
                                            <children>
                                                <Label text="EMAIL PROFESSIONNEL" styleClass="catalog-sidebar-label" />
                                                <TextField fx:id="emailField" promptText="nom@exemple.com" prefHeight="50" styleClass="promo-field" />
                                            </children>
                                        </VBox>

                                        <!-- Password Field -->
                                        <VBox spacing="8">
                                            <children>
                                                <Label text="MOT DE PASSE" styleClass="catalog-sidebar-label" />
                                                <HBox alignment="CENTER_LEFT" spacing="10">
                                                    <children>
                                                        <StackPane HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <PasswordField fx:id="passwordField" prefHeight="50" promptText="••••••••" styleClass="promo-field" />
                                                                <TextField fx:id="passwordVisibleField" managed="false" prefHeight="50" promptText="Votre mot de passe" visible="false" styleClass="promo-field" />
                                                            </children>
                                                        </StackPane>
                                                        <Button fx:id="togglePasswordBtn" onAction="#togglePassword" prefHeight="35" prefWidth="80" styleClass="outline-btn" text="VOIR" style="-fx-padding: 0 10; -fx-font-size: 11px;" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <Label fx:id="messageLabel" styleClass="catalog-sidebar-accent" text="" wrapText="true" alignment="CENTER" maxWidth="Infinity" />

                                        <Button fx:id="loginButton"
                                                text="CONNEXION"
                                                onAction="#handleLogin"
                                                maxWidth="Infinity"
                                                prefHeight="50"
                                                styleClass="secondary-btn"/>

                                        <VBox alignment="CENTER" spacing="5">
                                            <children>
                                                <Label text="Pas encore de compte ?" styleClass="footer-link" />
                                                <Label onMouseClicked="#allerInscription" styleClass="nav-link" text="S'INSCRIRE GRATUITEMENT"
                                                        style="-fx-font-size: 13px; -fx-padding: 0; -fx-background-color: transparent;" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="10">
                                            <children>
                                                <Button fx:id="adminLoginButton" maxWidth="Infinity" onAction="#allerAdminLogin" prefHeight="45" styleClass="outline-btn" text="🔐 CONNEXION ADMIN (RSA)" style="-fx-font-size: 12px;" />
                                                <Button maxWidth="Infinity" onAction="#allerAccueil" prefHeight="45" styleClass="outline-btn" text="🏠 RETOUR À L'ACCUEIL" style="-fx-font-size: 12px;" />
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>
