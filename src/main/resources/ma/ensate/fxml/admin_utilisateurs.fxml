<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Line?>

<VBox prefHeight="800.0" prefWidth="1280.0" spacing="0.0" styleClass="app-shell" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ma.ensate.client.views.AdminUtilisateursView">
    <children>
        <!-- Global Header -->
        <HBox alignment="CENTER_LEFT" prefHeight="90.0" styleClass="header-section">
            <children>
                <HBox alignment="CENTER" spacing="10.0" styleClass="brand-outline">
                    <children>
                        <Label styleClass="brand-mark" text="ChriOnline" />
                    </children>
                </HBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER" spacing="25.0">
                    <children>
                        <Button onAction="#handleProduits" mnemonicParsing="false" styleClass="nav-link-btn" text="PRODUITS" />
                        <Button onAction="#handleCommandesPlaceholder" mnemonicParsing="false" styleClass="nav-link-btn" text="COMMANDES" />
                        <Button mnemonicParsing="false" styleClass="nav-link-btn, nav-link-btn-active" text="UTILISATEURS" />
                        
                        <Region prefWidth="15.0" />
                        <VBox alignment="CENTER_RIGHT" spacing="2.0">
                            <children>
                                <Label text="ADMINISTRATEUR" style="-fx-text-fill: #ff9fc7; -fx-font-size: 11px; -fx-font-weight: 900; -fx-letter-spacing: 1.2px;" />
                                <Label text="SYSTÈME D'ACCÈS" style="-fx-text-fill: #6b7898; -fx-font-size: 10px; -fx-font-weight: 700;" />
                            </children>
                        </VBox>

                        <Button mnemonicParsing="false" onAction="#handleLogout" styleClass="logout-btn" text="DÉCONNEXION">
                           <HBox.margin>
                              <Insets left="10.0" />
                           </HBox.margin>
                        </Button>
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets left="42.0" right="42.0" />
            </padding>
        </HBox>

        <!-- Main Content Area -->
        <HBox VBox.vgrow="ALWAYS">
            <children>
                <!-- Left Pane: Users Table -->
                <VBox spacing="35.0" styleClass="catalog-wrap" HBox.hgrow="ALWAYS">
                    <children>
                        <VBox spacing="10">
                            <children>
                                <Label styleClass="section-kicker" text="ACCESS MANAGEMENT" />
                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <children>
                                        <Label styleClass="section-title" text="NOTRE" />
                                        <Label styleClass="section-title-accent" text="COMMUNAUTÉ" />
                                    </children>
                                </HBox>
                                <Line endX="100.0" styleClass="section-divider" />
                            </children>
                        </VBox>

                        <VBox spacing="25.0" styleClass="feature-card" VBox.vgrow="ALWAYS">
                            <children>
                                <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="idColumn" prefWidth="60.0" text="ID" />
                                        <TableColumn fx:id="nomColumn" prefWidth="200.0" text="UTILISATEUR" />
                                        <TableColumn fx:id="emailColumn" prefWidth="240.0" text="ADRESSE EMAIL" />
                                        <TableColumn fx:id="typeColumn" prefWidth="120.0" text="RÔLE" />
                                        <TableColumn fx:id="statutColumn" prefWidth="120.0" text="STATUT" />
                                        <TableColumn fx:id="actionsColumn" prefWidth="160.0" text="CONTRÔLE" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                                <Label fx:id="statusLabel" styleClass="catalog-sidebar-label" text="Prêt." />
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <!-- Right Pane: User Details (The Sidebar) -->
                <VBox prefWidth="400.0" styleClass="catalog-sidebar" spacing="30.0">
                    <children>
                        <Label styleClass="catalog-sidebar-accent" text="DÉTAILS DU COMPTE" />
                        
                        <VBox spacing="20.0" styleClass="shipping-card">
                            <children>
                                <VBox spacing="5">
                                    <children>
                                        <Label styleClass="catalog-sidebar-label" text="NOM COMPLET" />
                                        <Label fx:id="detailNom" styleClass="product-name" text="Selectionnez un utilisateur" wrapText="true" />
                                    </children>
                                </VBox>
                                <VBox spacing="5">
                                    <children>
                                        <Label styleClass="catalog-sidebar-label" text="EMAIL" />
                                        <Label fx:id="detailEmail" styleClass="hero-subtitle" text="—" />
                                    </children>
                                </VBox>
                                <HBox spacing="15">
                                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                                        <children>
                                            <Label styleClass="catalog-sidebar-label" text="RÔLE" />
                                            <Label fx:id="detailType" styleClass="category-tag" text="—" />
                                        </children>
                                    </VBox>
                                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                                        <children>
                                            <Label styleClass="catalog-sidebar-label" text="STATUT" />
                                            <Label fx:id="detailStatut" styleClass="stock-pill" text="—" />
                                        </children>
                                    </VBox>
                                </HBox>
                                <VBox spacing="5">
                                    <children>
                                        <Label styleClass="catalog-sidebar-label" text="TÉLÉPHONE" />
                                        <Label fx:id="detailTel" styleClass="hero-subtitle" text="—" />
                                    </children>
                                </VBox>
                                <VBox spacing="5">
                                    <children>
                                        <Label styleClass="catalog-sidebar-label" text="ADRESSE" />
                                        <Label fx:id="detailAdresse" styleClass="hero-subtitle" text="—" wrapText="true" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <VBox spacing="15.0" VBox.vgrow="ALWAYS" alignment="BOTTOM_CENTER">
                            <children>
                                <Button fx:id="btnSuspendre" maxWidth="Infinity" onAction="#handleSuspendre" styleClass="outline-btn" text="SUSPENDRE LE COMPTE" style="-fx-text-fill: #ffb86b; -fx-border-color: #ffb86b;" />
                                <Button fx:id="btnReactiver" maxWidth="Infinity" onAction="#handleReactiver" styleClass="secondary-btn" text="RÉACTIVER LE COMPTE" visible="false" managed="false" />
                            </children>
                        </VBox>
                    </children>
                    <padding>
                        <Insets top="40" bottom="40" left="30" right="30" />
                    </padding>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>