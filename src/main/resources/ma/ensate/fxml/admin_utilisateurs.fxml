<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ma.ensate.client.views.AdminUtilisateursView">
    <top>
        <VBox spacing="10.0" styleClass="header-section">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="14.0">
                    <children>
                        <Button onAction="#allerVersProduits" styleClass="secondary-btn" text="Gérer Produits" />
                        <Label text="Gestion des Utilisateurs" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                        <Button onAction="#handleLogout" styleClass="danger-btn" text="Déconnexion" HBox.hgrow="NEVER" />
                    </children>
                    <padding>
                        <Insets bottom="16.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <HBox spacing="20.0" style="-fx-background-color: white;">
            <children>
                <!-- Tableau des utilisateurs -->
                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Liste des utilisateurs" styleClass="section-title">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                        <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="idColumn" prefWidth="60.0" text="ID" />
                                <TableColumn fx:id="nomColumn" prefWidth="180.0" text="Nom" />
                                <TableColumn fx:id="emailColumn" prefWidth="220.0" text="Email" />
                                <TableColumn fx:id="typeColumn" prefWidth="120.0" text="Type" />
                                <TableColumn fx:id="statutColumn" prefWidth="100.0" text="Statut" />
                                <TableColumn fx:id="actionsColumn" prefWidth="150.0" text="Actions" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="10.0" top="20.0" />
                    </padding>
                </VBox>

                <!-- Panneau des détails -->
                <VBox prefWidth="320.0" spacing="15.0" style="-fx-background-color: #f8f9fa; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 0 1;">
                    <children>
                        <Label text="Détails de l'utilisateur" styleClass="section-title">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                            <VBox.margin>
                                <Insets top="20.0" />
                            </VBox.margin>
                        </Label>

                        <VBox spacing="12.0" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-background-radius: 8;">
                            <children>
                                <HBox spacing="10.0">
                                    <children>
                                        <Label text="Nom:" styleClass="detail-label" prefWidth="80.0">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Label>
                                        <Label fx:id="detailNom" text="—" wrapText="true" />
                                    </children>
                                    <padding>
                                        <Insets left="15.0" right="15.0" top="12.0" />
                                    </padding>
                                </HBox>

                                <HBox spacing="10.0">
                                    <children>
                                        <Label text="Email:" styleClass="detail-label" prefWidth="80.0">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Label>
                                        <Label fx:id="detailEmail" text="—" wrapText="true" />
                                    </children>
                                    <padding>
                                        <Insets left="15.0" right="15.0" />
                                    </padding>
                                </HBox>

                                <HBox spacing="10.0">
                                    <children>
                                        <Label text="Type:" styleClass="detail-label" prefWidth="80.0">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Label>
                                        <Label fx:id="detailType" text="—" />
                                    </children>
                                    <padding>
                                        <Insets left="15.0" right="15.0" />
                                    </padding>
                                </HBox>

                                <HBox spacing="10.0">
                                    <children>
                                        <Label text="Statut:" styleClass="detail-label" prefWidth="80.0">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Label>
                                        <Label fx:id="detailStatut" text="—" />
                                    </children>
                                    <padding>
                                        <Insets left="15.0" right="15.0" />
                                    </padding>
                                </HBox>

                                <HBox spacing="10.0">
                                    <children>
                                        <Label text="Adresse:" styleClass="detail-label" prefWidth="80.0">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Label>
                                        <Label fx:id="detailAdresse" text="—" wrapText="true" />
                                    </children>
                                    <padding>
                                        <Insets left="15.0" right="15.0" />
                                    </padding>
                                </HBox>

                                <HBox spacing="10.0">
                                    <children>
                                        <Label text="Téléphone:" styleClass="detail-label" prefWidth="80.0">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Label>
                                        <Label fx:id="detailTel" text="—" />
                                    </children>
                                    <padding>
                                        <Insets left="15.0" right="15.0" bottom="12.0" />
                                    </padding>
                                </HBox>
                            </children>
                            <padding>
                                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                            </padding>
                        </VBox>

                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <Button fx:id="btnSuspendre" onAction="#handleSuspendre" styleClass="danger-btn" text="Suspendre" />
                                <Button fx:id="btnReactiver" onAction="#handleReactiver" styleClass="primary-btn" text="Réactiver" />
                            </children>
                        </HBox>

                        <Label fx:id="statusLabel" styleClass="status-label" text="Prêt" />

                        <AnchorPane VBox.vgrow="ALWAYS" />
                    </children>
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                </VBox>
            </children>
        </HBox>
    </center>
</BorderPane>