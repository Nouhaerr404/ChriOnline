<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Line?>

<StackPane fx:id="rootPane" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <ScrollPane fitToWidth="true" styleClass="app-shell">
            <content>
                <VBox alignment="TOP_CENTER" spacing="40" styleClass="app-shell">
                    <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="90.0" styleClass="header-section">
                            <children>
                                <HBox alignment="CENTER" spacing="10.0" styleClass="brand-outline">
                                    <children>
                                        <Label styleClass="brand-mark" text="ChriOnline" />
                                    </children>
                                </HBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <HBox alignment="CENTER" spacing="25.0">
                                    <children>
                                        <Button mnemonicParsing="false" onAction="#retourBoutique" styleClass="nav-link-btn" text="BOUTIQUE" />
                                        <Button mnemonicParsing="false" onAction="#goToOrders" styleClass="nav-link-btn" text="COMMANDES" />
                                        <Button mnemonicParsing="false" onAction="#goToPanier" styleClass="nav-link-btn" text="PANIER" />
                                        
                                        <Button mnemonicParsing="false" onAction="#goToProfil" styleClass="profile-bubble-btn">
                                            <graphic>
                                                <HBox alignment="CENTER" mouseTransparent="true" pickOnBounds="true" spacing="12.0" styleClass="profile-bubble">
                                                    <children>
                                                        <Label fx:id="profileHoverLabel" mouseTransparent="true" styleClass="profile-hover" text="MON COMPTE" visible="false" managed="false"/>
                                                        <Label fx:id="profileInitialLabel" mouseTransparent="true" styleClass="profile-initial" text="U" />
                                                    </children>
                                                </HBox>
                                            </graphic>
                                        </Button>

                                        <Button mnemonicParsing="false" onAction="#handleLogout" styleClass="logout-btn" text="DÉCONNEXION">
                                           <HBox.margin>
                                              <Insets left="10.0" />
                                           </HBox.margin>
                                        </Button>
                                    </children>
                                </HBox>
                            </children>
                            <padding>
                                <Insets left="42.0" right="42.0" />
                            </padding>
                        </HBox>
                        <!-- ... rest of VBox content ... -->

                <VBox alignment="CENTER" spacing="0" maxWidth="1200">
                    <children>
                        <HBox spacing="40" alignment="TOP_CENTER">
                            <children>
                                <VBox spacing="30" prefWidth="650" styleClass="showcase-card" style="-fx-pref-height: -1; -fx-padding: 40;">
                                    <children>
                                        <VBox spacing="10">
                                            <children>
                                                <Label text="MÉTHODE DE PAIEMENT" styleClass="summary-title" />
                                                <Label text="Choisissez votre mode de règlement préféré." styleClass="catalog-sidebar-label" />
                                                <Line endX="60" styleClass="section-divider" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="20">
                                            <children>
                                                <RadioButton fx:id="rbCard" text="CARTE BANCAIRE (VISA / MASTERCARD)" selected="true" styleClass="nav-link" style="-fx-font-size: 16px;">
                                                    <toggleGroup><ToggleGroup fx:id="group"/></toggleGroup>
                                                </RadioButton>
                                                
                                                <VBox fx:id="cardForm" spacing="20" styleClass="shipping-card">
                                                    <children>
                                                        <VBox spacing="8">
                                                            <children>
                                                                <Label text="NUMÉRO DE CARTE" styleClass="catalog-sidebar-label" />
                                                                <TextField fx:id="txtNum" promptText="XXXX XXXX XXXX XXXX" styleClass="promo-field" prefHeight="55" style="-fx-font-family: 'Monospacded';" />
                                                            </children>
                                                        </VBox>
                                                        <HBox spacing="20">
                                                            <children>
                                                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                                                    <children>
                                                                        <Label text="EXPIRATION (MM/AA)" styleClass="catalog-sidebar-label" />
                                                                        <TextField fx:id="txtExp" promptText="01/27" styleClass="promo-field" prefHeight="50" />
                                                                    </children>
                                                                </VBox>
                                                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                                                    <children>
                                                                        <Label text="CVC" styleClass="catalog-sidebar-label" />
                                                                        <TextField fx:id="txtCvv" promptText="123" styleClass="promo-field" prefHeight="50" />
                                                                    </children>
                                                                </VBox>
                                                            </children>
                                                        </HBox>
                                                        <VBox spacing="8">
                                                            <children>
                                                                <Label text="TITULAIRE" styleClass="catalog-sidebar-label" />
                                                                <TextField fx:id="txtHold" promptText="PRÉNOM NOM" styleClass="promo-field" prefHeight="50" />
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </VBox>

                                                <RadioButton fx:id="rbCash" text="PAIEMENT À LA LIVRAISON" toggleGroup="$group" styleClass="nav-link" style="-fx-font-size: 16px;" />
                                                
                                                <VBox fx:id="livraisonForm" spacing="15" visible="false" managed="false" styleClass="shipping-card">
                                                    <padding><Insets left="20" /></padding>
                                                    <children>
                                                       <RadioButton fx:id="rbLivraisonCash" text="Espèces (Cash)" selected="true" styleClass="footer-link">
                                                           <toggleGroup><ToggleGroup fx:id="livraisonGroup"/></toggleGroup>
                                                       </RadioButton>
                                                       <RadioButton fx:id="rbLivraisonCard" text="Carte à la livraison" toggleGroup="$livraisonGroup" styleClass="footer-link" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>

                                <VBox spacing="35" prefWidth="420" styleClass="summary-card">
                                    <children>
                                        <VBox spacing="10">
                                            <children>
                                                <Label text="VOTRE COMMANDE" styleClass="summary-title" />
                                                <Label fx:id="lblSub" text="Résumé des articles dans votre panier." styleClass="catalog-sidebar-label" />
                                            </children>
                                        </VBox>
                                        
                                        <Separator styleClass="summary-separator" />
                                        
                                        <VBox spacing="15">
                                            <children>
                                                <HBox alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Total Commande" styleClass="summary-label" />
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <Label fx:id="valT" text="0.00 MAD" styleClass="summary-total-accent" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <VBox spacing="15" styleClass="shipping-card">
                                            <children>
                                                <Label fx:id="tlsStatusLabel" text="TLS ACTIF" styleClass="shipping-title" style="-fx-text-fill: #5cff90;" />
                                                <Label fx:id="tlsDetailsLabel" text="Votre paiement sera envoyé via une connexion TLS chiffrée vers le serveur sécurisé sur le port 9999." styleClass="shipping-copy" wrapText="true" />
                                            </children>
                                        </VBox>

                                        <Region VBox.vgrow="ALWAYS" />

                                        <Button fx:id="btnPay" onAction="#handlePayment" maxWidth="Infinity" prefHeight="65" styleClass="secondary-btn" text="CONFIRMER ET PAYER VIA TLS" />
                                        <Button onAction="#handleRetour" maxWidth="Infinity" prefHeight="55" styleClass="outline-btn" text="RETOUR AU PANIER" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
                <Region prefHeight="50" />
            </children>
        </VBox>
    </content>
        </ScrollPane>
    </children>
</StackPane>
