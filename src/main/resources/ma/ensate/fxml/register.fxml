<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Line?>

<VBox alignment="CENTER" prefHeight="800.0" prefWidth="600.0" spacing="0.0" styleClass="app-shell" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ma.ensate.client.views.RegisterView">
    <children>
        <VBox alignment="CENTER" maxWidth="500.0" spacing="35.0" style="-fx-padding: 40;" styleClass="hero-panel">
            <children>
                <VBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Label styleClass="brand-mark" text="ChriOnline" />
                        <Label styleClass="section-kicker" text="REJOINDRE LA COMMUNAUTÉ" />
                    </children>
                </VBox>
                
                <VBox spacing="25.0">
                    <children>
                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="catalog-sidebar-label" text="NOM COMPLET" />
                                <TextField fx:id="nomField" prefHeight="48.0" promptText="Votre nom" styleClass="text-field" />
                            </children>
                        </VBox>
                        
                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="catalog-sidebar-label" text="ADRESSE EMAIL" />
                                <TextField fx:id="emailField" prefHeight="48.0" promptText="exemple@email.com" styleClass="text-field" />
                            </children>
                        </VBox>
                        
                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="catalog-sidebar-label" text="NUMÉRO DE TÉLÉPHONE" />
                                <TextField fx:id="telField" prefHeight="48.0" promptText="06..." styleClass="text-field" />
                            </children>
                        </VBox>

                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="catalog-sidebar-label" text="MOT DE PASSE" />
                                <PasswordField fx:id="mdpField" prefHeight="48.0" promptText="••••••••" styleClass="text-field" />
                            </children>
                        </VBox>

                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="catalog-sidebar-label" text="CONFIRMATION" />
                                <PasswordField fx:id="confirmMdpField" prefHeight="48.0" promptText="••••••••" styleClass="text-field" />
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <VBox spacing="15.0">
                    <children>
                        <Button fx:id="registerBtn" maxWidth="Infinity" onAction="#handleRegister" prefHeight="55.0" styleClass="secondary-btn" text="CRÉER MON COMPTE" />
                        <Button maxWidth="Infinity" onAction="#goBack" prefHeight="55.0" styleClass="outline-btn" text="RETOUR À LA CONNEXION" />
                    </children>
                </VBox>

                <Label fx:id="statusLabel" alignment="CENTER" maxWidth="Infinity" styleClass="catalog-sidebar-label" text="Tous les champs sont obligatoires" textAlignment="CENTER" wrapText="true" />
            </children>
        </VBox>
    </children>
</VBox>
