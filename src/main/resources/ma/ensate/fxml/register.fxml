<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ma.ensate.client.views.RegisterView"
      alignment="CENTER"
      spacing="12"
      style="-fx-background-color: #f0f4f8; -fx-padding: 40;">


    <Label text="ChriOnline"
           style="-fx-font-size: 28px; -fx-font-weight: bold;
                  -fx-text-fill: #1a73e8;"/>
    <Label text="Créer un compte"
           style="-fx-font-size: 14px; -fx-text-fill: #666;"/>


    <VBox spacing="12"
          style="-fx-background-color: white;
                 -fx-padding: 25;
                 -fx-background-radius: 10;
                 -fx-effect: dropshadow(gaussian, #ccc, 10, 0, 0, 2);"
          maxWidth="420">


        <Label text="Nom complet"
               style="-fx-font-weight: bold; -fx-text-fill: #333;"/>
        <TextField fx:id="nomField"
                   promptText="Votre nom complet"
                   style="-fx-padding: 10; -fx-background-radius: 5;
                          -fx-border-color: #ddd; -fx-border-radius: 5;"/>

        <Label text="Email"
               style="-fx-font-weight: bold; -fx-text-fill: #333;"/>
        <TextField fx:id="emailField"
                   promptText="Votre email"
                   style="-fx-padding: 10; -fx-background-radius: 5;
                          -fx-border-color: #ddd; -fx-border-radius: 5;"/>


        <Label text="Mot de passe (min. 6 caractères)"
               style="-fx-font-weight: bold; -fx-text-fill: #333;"/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <StackPane HBox.hgrow="ALWAYS">
                <PasswordField fx:id="passwordField"
                               promptText="Votre mot de passe"
                               maxWidth="Infinity"
                               style="-fx-padding: 10; -fx-background-radius: 5;
                                      -fx-border-color: #ddd; -fx-border-radius: 5;"/>
                <TextField fx:id="passwordVisibleField"
                           promptText="Votre mot de passe"
                           visible="false"
                           managed="false"
                           maxWidth="Infinity"
                           style="-fx-padding: 10; -fx-background-radius: 5;
                                  -fx-border-color: #ddd; -fx-border-radius: 5;"/>
            </StackPane>
            <Button fx:id="togglePasswordBtn"
                    text="Voir"
                    onAction="#togglePassword"
                    style="-fx-background-color: #e8f0fe;
                           -fx-text-fill: #1a73e8;
                           -fx-font-weight: bold;
                           -fx-background-radius: 5;
                           -fx-cursor: hand;"/>
        </HBox>

        <Label text="Adresse (optionnel)"
               style="-fx-font-weight: bold; -fx-text-fill: #333;"/>
        <TextField fx:id="adresseField"
                   promptText="Votre adresse"
                   style="-fx-padding: 10; -fx-background-radius: 5;
                          -fx-border-color: #ddd; -fx-border-radius: 5;"/>

        <Label text="Téléphone (optionnel)"
               style="-fx-font-weight: bold; -fx-text-fill: #333;"/>
        <TextField fx:id="telField"
                   promptText="Votre téléphone"
                   style="-fx-padding: 10; -fx-background-radius: 5;
                          -fx-border-color: #ddd; -fx-border-radius: 5;"/>

        <Label fx:id="messageLabel"
               text=""
               style="-fx-font-size: 12px;"
               wrapText="true"/>

        <Button fx:id="registerButton"
                text="S'inscrire"
                onAction="#handleRegister"
                maxWidth="Infinity"
                style="-fx-background-color: #34a853;
                       -fx-text-fill: white;
                       -fx-font-size: 14px;
                       -fx-padding: 12;
                       -fx-background-radius: 5;
                       -fx-cursor: hand;"/>

        <HBox alignment="CENTER" spacing="5">
            <Label text="Déjà un compte ?"
                   style="-fx-text-fill: #666;"/>
            <Hyperlink text="Se connecter"
                       onAction="#allerLogin"
                       style="-fx-text-fill: #1a73e8;"/>
        </HBox>

    </VBox>
</VBox>
