<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1280.0" styleClass="app-shell" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ma.ensate.client.views.LandingView">
   <children>
      <ScrollPane fitToWidth="true" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" styleClass="content-scroll">
         <content>
            <VBox spacing="0.0" styleClass="app-shell">
               <children>
                  <!-- Navbar -->
                  <HBox alignment="CENTER_LEFT" prefHeight="90.0" spacing="30.0" styleClass="header-section">
                     <children>
                        <HBox alignment="CENTER" spacing="10.0" styleClass="brand-outline">
                            <children>
                                <Label styleClass="brand-mark" text="ChriOnline" />
                            </children>
                        </HBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER" spacing="35.0">
                           <children>
                              <Label styleClass="nav-link" text="ACCUEIL" />
                              <Label onMouseClicked="#handleLogin" styleClass="nav-link" text="BOUTIQUE" />
                              <Label onMouseClicked="#goToCart" styleClass="nav-link" text="PANIER" />
                              <Button mnemonicParsing="false" onAction="#handleRegister" styleClass="outline-btn" text="S'INSCRIRE" style="-fx-padding: 10 20;" />
                              <Button mnemonicParsing="false" onAction="#handleLogin" styleClass="logout-btn" text="CONNEXION" />
                           </children>
                        </HBox>
                     </children>
                  </HBox>

                  <!-- Hero Section -->
                  <VBox styleClass="hero-box">
                      <children>
                          <StackPane styleClass="hero-panel">
                             <children>
                                <VBox alignment="CENTER" spacing="35.0">
                                   <children>
                                      <Label styleClass="hero-kicker" text="PREMIUM E-COMMERCE HUB" />
                                      <VBox alignment="CENTER" spacing="5.0">
                                          <children>
                                              <Label styleClass="hero-title" text="L'ÉLÉGANCE À PORTÉE" textAlignment="CENTER" />
                                              <Label styleClass="hero-title-accent" text="DE CLIC" textAlignment="CENTER" />
                                          </children>
                                      </VBox>
                                      <Label styleClass="hero-subtitle" text="Découvrez notre sélection exclusive de produits premium au meilleur prix." textAlignment="CENTER" maxWidth="700" />
                                      <HBox alignment="CENTER" spacing="25.0">
                                         <children>
                                            <Button mnemonicParsing="false" onAction="#handleLogin" styleClass="secondary-btn" text="EXPLORER MAINTENANT" />
                                            <Button mnemonicParsing="false" onAction="#handleLogin" styleClass="outline-btn" text="VOIR LE CATALOGUE" />
                                         </children>
                                         <VBox.margin>
                                            <Insets top="15.0" />
                                         </VBox.margin>
                                      </HBox>
                                   </children>
                                </VBox>
                             </children>
                          </StackPane>
                      </children>
                  </VBox>

                  <!-- Features Section -->
                  <VBox styleClass="section-block" spacing="50.0">
                     <children>
                        <VBox spacing="10.0">
                            <children>
                                <Label styleClass="section-kicker" text="NOS SERVICES" />
                                <HBox alignment="CENTER_LEFT" spacing="20.0">
                                    <children>
                                        <Label styleClass="section-title" text="POURQUOI" />
                                        <Label styleClass="section-title-accent" text="NOUS CHOISIR?" />
                                    </children>
                                </HBox>
                                <Line endX="120.0" styleClass="section-divider" />
                            </children>
                        </VBox>
                        
                        <GridPane hgap="35.0" vgap="35.0">
                          <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                          </columnConstraints>
                          <rowConstraints>
                            <RowConstraints minHeight="10.0" prefHeight="320.0" vgrow="SOMETIMES" />
                          </rowConstraints>
                           <children>
                              <VBox spacing="25.0" styleClass="feature-card">
                                 <children>
                                    <Label styleClass="feature-badge" text="FAST DELIVERY" />
                                    <Label text="LIVRAISON RAPIDE" styleClass="feature-heading" />
                                    <Label text="Recevez vos produits en un temps record partout au Maroc avec une traçabilité complète." styleClass="feature-copy" wrapText="true" />
                                    <Region VBox.vgrow="ALWAYS" />
                                    <Label onMouseClicked="#handleLogin" text="EN SAVOIR PLUS →" styleClass="feature-link" style="-fx-cursor: hand;" />
                                 </children>
                              </VBox>
                              <VBox spacing="25.0" styleClass="feature-card" GridPane.columnIndex="1">
                                 <children>
                                    <Label styleClass="feature-badge" text="SAFE PAYMENT" />
                                    <Label text="PAIEMENT SÉCURISÉ" styleClass="feature-heading" />
                                    <Label text="Transactions ultra-sécurisées par carte ou à la livraison pour une tranquillité totale." styleClass="feature-copy" wrapText="true" />
                                    <Region VBox.vgrow="ALWAYS" />
                                    <Label onMouseClicked="#handleLogin" text="DÉTAILS SÉCURITÉ →" styleClass="feature-link" style="-fx-cursor: hand;" />
                                 </children>
                              </VBox>
                              <VBox spacing="25.0" styleClass="feature-card" GridPane.columnIndex="2">
                                 <children>
                                    <Label styleClass="feature-badge" text="SUPPORT 24/7" />
                                    <Label text="ASSISTANCE DÉDIÉE" styleClass="feature-heading" />
                                    <Label text="Une équipe d'experts à votre écoute jour et nuit pour répondre à toutes vos questions." styleClass="feature-copy" wrapText="true" />
                                    <Region VBox.vgrow="ALWAYS" />
                                    <Label onMouseClicked="#handleLogin" text="CONTACTER L'AIDE →" styleClass="feature-link" style="-fx-cursor: hand;" />
                                 </children>
                              </VBox>
                           </children>
                        </GridPane>
                     </children>
                     <padding>
                        <Insets bottom="80" top="30" />
                     </padding>
                  </VBox>

                  <!-- Footer -->
                  <HBox alignment="CENTER_LEFT" spacing="0.0" styleClass="landing-footer">
                     <children>
                        <Label text="CHRI ONLINE" styleClass="footer-brand" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER" spacing="30.0">
                           <children>
                              <Label text="CONFIDENTIALITÉ" styleClass="footer-link" />
                              <Label text="CGU" styleClass="footer-link" />
                              <Label text="SUPPORT" styleClass="footer-link" />
                              <Label text="© 2026 HUB" styleClass="footer-link" />
                           </children>
                        </HBox>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </children>
</AnchorPane>
